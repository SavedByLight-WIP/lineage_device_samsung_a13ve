# Device nodes
/dev/block/platform/bootdevice/by-name/.* u:object_r:block_device:s0
/dev/block/bootdevice/by-name/.* u:object_r:block_device:s0
/dev/ttyMSM[0-9]* u:object_r:tty_device:s0
